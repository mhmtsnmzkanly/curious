[Unit]
Description=Curious simulation and control API
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/curious
ExecStart=/root/curious/target/release/curious --serve --resume-or-new --paused --data-dir /root/curious/data/main --bind 127.0.0.1:7878 --shard-mb 256 --max-history-mb 10240
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
