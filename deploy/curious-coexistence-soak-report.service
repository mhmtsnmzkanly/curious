[Unit]
Description=Report real elapsed days for the qualified mixed world
[Service]
Type=oneshot
EnvironmentFile=/root/curious/data/coexistence-runtime.env
WorkingDirectory=/root/curious
ExecStart=/usr/bin/python3 ${CURIOUS_OBSERVATION_SCRIPTS}/report_soak.py --directory /root/curious/data/soak-coexistence --state /root/curious/data/coexistence-soak-report.json --label karma-dunya --key-prefix curious-coexistence --page-id ${CURIOUS_PAGE}
TimeoutStartSec=55
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
