[Unit]
Description=Frozen gated coexistence experiments and conditional separate-world deployment
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=3
[Service]
Type=simple
WorkingDirectory=/root/curious-research/current
ExecStart=/usr/bin/python3 -u /root/curious-research/current/scripts/research_coexistence.py --config /root/curious/data/coexistence-research/config.json
Restart=on-failure
RestartSec=30
Nice=10
CPUQuota=180%
MemoryMax=512M
KillMode=control-group
TimeoutStopSec=40
RuntimeMaxSec=8d
UMask=0077
[Install]
WantedBy=multi-user.target
